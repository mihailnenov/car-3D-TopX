// =========================================================================
// ГЛАВИНА С ЧАШКА (WHEEL HUB CUP) - ИЗНЕСЕНА НАВЪН ЗА СВОБОДЕН ЗАВОЙ
// Оптимизирана за 3D принт (лежи на широкия фланец без подпори)
// =========================================================================

$fn = 64;
tol = 0.15;

module wheel_hub_cup_extended() {
    color("SteelBlue")
    difference() {
        union() {
            // 1. Вал с диаметър 10 мм, който минава през двата лагера 10x15x4 в шенкела
            translate([-5.5, 0, 0]) 
                rotate([0, 90, 0]) 
                cylinder(d = 10.0 - tol, h = 11.5);
            
            // 2. Упорен пръстен, който опира във вътрешната гривна на външния лагер
            translate([5.0, 0, 0]) 
                rotate([0, 90, 0]) 
                cylinder(d = 11.8, h = 1.5);
            
            // 3. Широк монтажен фланец (Ф25 мм), изнесен навън (от X = +6.5 до +9.5 мм)
            // Това изкарва чашката извън тялото на джантата, осигурявайки луфт за завиване!
            translate([6.5, 0, 0]) 
                rotate([0, 90, 0]) 
                cylinder(d = 25.0, h = 3.0);
            
            // 4. Центриращ пръстен към барабана на джантата
            translate([9.5, 0, 0]) 
                rotate([0, 90, 0]) 
                cylinder(d = 14.0, h = 2.5);
        }
        
        // --- ВЪТРЕШНИ КУХИНИ И КАНАЛИ ---
        
        // Вътрешна цилиндрична кухина за сферата на полуоската
        translate([-6.5, 0, 0]) 
            rotate([0, 90, 0]) 
            cylinder(d = 7.0, h = 9.5);
            
        // Сферично легло в центъра
        sphere(d = 7.0);
        
        // Широка входна фаска (Ф8.6 -> Ф7.0 мм) от лявата страна за голям ъгъл на завой
        translate([-5.6, 0, 0])
            rotate([0, 90, 0])
            cylinder(d1 = 8.6, d2 = 7.0, h = 2.6);
            
        // Прорези (канали) за напречния щифт Ф1.5 мм на полуоската
        hull() {
            translate([-3.5, 0, 0]) rotate([90, 0, 0]) cylinder(d = 1.9, h = 12, center = true);
            translate([ 2.5, 0, 0]) rotate([90, 0, 0]) cylinder(d = 1.9, h = 12, center = true);
        }
        
        // 3 броя монтажни отвори M3.5 за захващане към барабана на колелото
        for (a = [0, 120, 240]) {
            rotate([a, 0, 0])
            translate([6.0, 0, 8.5])
                rotate([0, 90, 0])
                cylinder(d = 3.6, h = 8);
        }
        
        // Централен проходен отвор за облекчение
        translate([0, 0, 0]) 
            rotate([0, 90, 0]) 
            cylinder(d = 3.2, h = 25);
    }
}

// Ориентация за експорт към STL: ляга на широкия фланец (Z = 0) без никакви подпори!
translate([0, 0, 9.5]) 
    rotate([0, -90, 0]) 
    wheel_hub_cup_extended();