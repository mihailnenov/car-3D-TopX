// =========================================================================
// ОБРЪЧ / ШЕНКЕЛ ЗА C-HUB ОКАЧВАНЕ (ВЕРСИЯ 4 - 8мм ДЕБЕЛИНА ЗА 2 ЛАГЕРА)
// Оптимизиран за 100% печат без подпори (лежи плоско на плочата на Z=0)
// =========================================================================

$fn = 90;

// --- ОСНОВНИ ПАРАМЕТРИ ---
bearing_od  = 15.15; // Проходен диаметър за лагерите (без вътрешен праг)
hoop_width  = 8.0;   // Точна дебелина на обръча (покрива напълно 2 лагера по 4мм = 8мм)
ear_width   = 8.0;   // Дебелина на ушите (изравнена с обръча за здрав и плосък печат)
hoop_od     = 22.0;  // Външен диаметър на обръча

kingpin_d   = 4;   // Отвор за вертикалната панта (М3 щифт/болт)
kingpin_h   = 24.0;  // Обща височина на пантата (от ухо до ухо)

arm_length  = 18.0;  // Дължина на рамото за кормилната щанга
arm_hole_d  = 4;   // Отвор за ябълковидния болт на щангата

module steering_block_printable() {
    color("SteelBlue")
    difference() {
        // =================================================================
        // 1. ОСНОВНО ТЯЛО (ПОЗИТИВ)
        // Всички елементи са 8.0 мм дебели и лежат плоско на Z = 0
        // =================================================================
        union() {
            // А) Централната шайба (точно 8.0 мм дебелина)
            translate([0, 0, hoop_width / 2])
                cylinder(d = hoop_od, h = hoop_width, center = true);

            // Б) Уши за пантите (8.0 мм дебелина)
            translate([0, 0, ear_width / 2])
                rotate([90, 0, 0])
                    cylinder(d = ear_width, h = kingpin_h, center = true);
                    
            // В) Плавен преход между ушите и шайбата
            hull() {
                translate([0, 0, ear_width / 2])
                    rotate([90, 0, 0]) 
                        cylinder(d = ear_width, h = kingpin_h - 4, center = true);
                translate([0, 0, hoop_width / 2])
                    cylinder(d = hoop_od, h = hoop_width, center = true);
            }
                
            // Г) Рамо за кормилната щанга
            hull() {
                translate([0, 0, hoop_width / 2])
                    cylinder(d = hoop_od, h = hoop_width, center = true);
                translate([arm_length, 0, ear_width / 2])
                    cylinder(d = ear_width, h = ear_width, center = true);
            }
        }
        
        // =================================================================
        // 2. ИЗРЯЗВАНИЯ И ОТВОРИ (НЕГАТИВ)
        // =================================================================
        
        // А) ПРОХОДНО легло за лагерите (Ф15.15 мм)
        // Лагерите се набиват от двете страни и се срещат в средата.
        translate([0, 0, -1])
            cylinder(d = bearing_od, h = hoop_width + 2);
            
        // Б) Отвор за вертикалния щифт/панта
        translate([0, 0, ear_width / 2])
            rotate([90, 0, 0]) 
                cylinder(d = kingpin_d, h = kingpin_h + 2, center = true);
            
        // В) Отвор за кормилната щанга в края на рамото
        translate([arm_length, 0, -1]) 
            cylinder(d = arm_hole_d, h = ear_width + 2);
    }
}

// Рендериране на детайла (вече е позициониран директно върху масата)
steering_block_printable();