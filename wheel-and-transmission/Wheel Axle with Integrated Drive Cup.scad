// =========================================================================
// ГЛАВИНА С ЧАШКА (WHEEL HUB OUTDRIVE - С КОНУСЕН ПРЕХОД КЪМ ОСНОВАТА)
// - Секция 1 (Лагери + Чашка): Дължина 8.0 мм, Диаметър 10.0 мм (Z = 0 до 8.0 мм)
// - Канали за щифта: 5.0 мм дълги, на 1.5 мм от двата края (от Z = 1.5 до Z = 6.5 мм)
// - Прав 90° праг на Z = 8.0 мм (за челно опиране на лагера 10x15x4)
// - Секция 2 (Шийка): Дължина 10.0 мм, Диаметър 12.0 мм (от Z = 8.0 до Z = 18.0 мм)
// - Секция 3 (Основа): Дължина 10.0 мм (от Z = 18.0 до Z = 28.0 мм) с 45° конусен преход!
// - Чело: Централен водач Ф5.8 мм + 3x "Pill" профила + 3x отвора Ф2.65 мм за резба М3
// =========================================================================

$fn = 90;
tol = 0.10; // Толеранс за плътно набиване в лагерите 10x15x4 (9.88 мм)

// --- РАЗМЕРИ ПО ОС Z ---
cup_len      = 8.0;           // Точно 8.0 мм за два допрени лагера 10x15x4 (2 x 4.0 мм)
neck_len     = 15.0;          // 15.0 мм междинна шийка
base_len     = 10.0;          // 10.0 мм основа за барабана
cone_h       = 5.0;           // Височина на 45° конусен преход ((22 - 12) / 2 = 5.0 мм)

cup_od       = 10.0 + tol;    // 10.10 мм (равен вал за лагерите)
neck_od      = 12.0;          // Прав праг на Z = 8.0 мм (опира само във вътрешната гривна на лагера!)
base_od      = 22.0;          // Основа Ф22.0 мм

// --- ЧАШКА И КАНАЛИ (СИМЕТРИЧНИ В 8-МИЛИМЕТРОВАТА СЕКЦИЯ) ---
cup_id       = 6.8;           // Вътрешен отвор 6.0 мм -> Дебелина на стената почти 2.0 мм!
slot_len     = 5.0;           // 5.0 мм дължина на канала
slot_margin  = 1.5;           // 1.5 мм отстояние от двата края на 8мм секция (1.5 + 5.0 + 1.5 = 8.0)
slot_w       = 1.80;          // Ширина на канала за Ф1.5 мм щифт

// --- МОНТАЖ КЪМ БАРАБАНА (М3 РЕЗБИ И ПРОФИЛИ) ---
bolt_circle_d = 15.0;         // R = 7.5 мм
m3_tap_d      = 2.65;         // Отвор за нарязване на резба М3 с метчик
m3_tap_depth  = 8.5;          // Дълбочина на резбата
pilot_d       = 5.80;         // Централен водач за 6.0 мм отвор на барабана

// Достъп до размерите от други файлове (use <...> внася само модули и функции, не и променливи)
function hub_param(key) =
    let (t = [
        ["cup_len", cup_len], ["face_z", cup_len + neck_len + base_len], ["cup_id", cup_id],
        ["slot_margin", slot_margin], ["slot_w", slot_w], ["base_od", base_od]
    ], i = search([key], t)[0])
    assert(is_num(i), str("hub_param: непознат ключ ", key))
    t[i][1];


module exact_wheel_hub_conical() {
    top_z = cup_len + neck_len + base_len; // Обща височина на тялото = 28.0 мм
    
    color("SteelBlue")
    difference() {
        // =================================================================
        // 1. ВЪНШНО ТЯЛО
        // =================================================================
        union() {
            // А) Секция 1: Равен 10мм вал за двата лагера 10x15x4 (Z = 0 до 8.0 мм)
            cylinder(d = cup_od, h = cup_len);
            
            // Б) Секция 2: Междинна шийка Ф12.0 мм с ПРАВ ПРАГ на Z = 8.0 мм (Z = 8.0 до 18.0 мм)
            translate([0, 0, cup_len])
                cylinder(d = neck_od, h = neck_len);
                
            // В) Секция 3: Основа Ф22.0 мм (Z = 18.0 до 28.0 мм) с 45° самоносещ конус в долните 5 мм
            translate([0, 0, cup_len + neck_len]) {
                cylinder(d1 = neck_od, d2 = base_od, h = cone_h);
                translate([0, 0, cone_h])
                    cylinder(d = base_od, h = base_len - cone_h);
            }
                
            // Г) Централен водач Ф5.80 мм на челото (Z = 28.0 до 31.0 мм)
            translate([0, 0, top_z]) {
                cylinder(d = pilot_d, h = 2.4);
                translate([0, 0, 2.4])
                    cylinder(d1 = pilot_d, d2 = pilot_d - 0.6, h = 0.6);
            }
            
            // Д) 3x Водещи "Pill" пинове за барабана (1.8 x 5.0 мм на R = 7.8 мм)
            for (i = [0 : 2]) {
                rotate([0, 0, i * 120 + 60])
                translate([7.8, 0, top_z])
                hull() {
                    translate([0, -1.6, 0]) cylinder(d = 1.8, h = 2.2);
                    translate([0,  1.6, 0]) cylinder(d = 1.8, h = 2.2);
                    translate([0, -1.4, 2.2]) cylinder(d = 1.4, h = 0.6);
                    translate([0,  1.4, 2.2]) cylinder(d = 1.4, h = 0.6);
                }
            }
        }
        
        // =================================================================
        // 2. ВЪТРЕШНИ КУХИНИ, КАНАЛИ И ОТВОРИ ЗА РЕЗБА М3
        // =================================================================
        
        // А) Вътрешен отвор на чашката Ф6.0 мм (оставя 2.0 мм плътна стена!)
        translate([0, 0, -0.1])
            cylinder(d = cup_id, h = cup_len - slot_margin + 0.1);
            
        translate([0, 0, cup_len - slot_margin])
            sphere(d = cup_id);
            
        // Малка входна фаска (0.7 мм), за да остане предният пръстен дебел и здрав
        translate([0, 0, -0.1])
            cylinder(d1 = cup_id + 1.0, d2 = cup_id, h = 0.8);
            
        // Б) КАНАЛИ ЗА ЩИФТА: Дължина точно 5.0 мм (от Z = 1.5 мм до Z = 6.5 мм)
        z_start = slot_margin + slot_w / 2;               // Долен ръб точно на 1.5 мм
        z_end   = cup_len - slot_margin - slot_w / 2;     // Горен ръб точно на 6.5 мм
        
        hull() {
            translate([0, 0, z_start])
                rotate([90, 0, 0])
                cylinder(d = slot_w, h = cup_od + 4, center = true);
            translate([0, 0, z_end])
                rotate([90, 0, 0])
                cylinder(d = slot_w, h = cup_od + 4, center = true);
        }
        
        // В) 3x Кръгли отвора Ф2.65 мм за нарязване на резба М3 (на R = 7.5 мм, дълбочина 8.5 мм)
        for (i = [0 : 2]) {
            rotate([0, 0, i * 120])
            translate([bolt_circle_d / 2, 0, top_z - m3_tap_depth]) {
                cylinder(d = m3_tap_d, h = m3_tap_depth + 0.5);
                // Фаска на входа за метчика
                translate([0, 0, m3_tap_depth - 0.7])
                    cylinder(d1 = m3_tap_d, d2 = 3.4, h = 0.8);
            }
        }
        
        // Г) Централен проходен отвор Ф2.5 мм
        translate([0, 0, -1])
            cylinder(d = 2.5, h = top_z + 6);
    }
}

// Рендериране
exact_wheel_hub_conical();