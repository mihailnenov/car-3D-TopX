// =========================================================================
// САМОСТОЯТЕЛЕН OPENSCAD ФАЙЛ: ЕДИНИЧНА ПОЛУОСКА (НА ПОЛОВИН ДЪЛЖИНА)
// На базата на оригиналния код за double_dogbone_shaft_printable()
// Параметри:
// - Дължина: 27.42 мм (точно половината от 54.83 мм)
// - Една сфера в левия край + прав вал в десния край за набиване на зъбно колело
// - Увеличен вертикален отвор за щифта: 1.75 мм (вместо 1.55 мм)
// - Кръгла шийка (без опорно ребро) в първите 5.5 мм от сферата -> завой ±20° в чашката
//   на "Wheel Axle with Integrated Drive Cup.scad" (с ребро до сферата завоят беше само ±15°)
// =========================================================================

$fn = 90;

// Глобални константи от твоя мост
kingpin_x     = 72.0;
diff_cup_x    = 18.0;
dogbone_l     = kingpin_x - diff_cup_x; // 54.0 мм
diff_z_offset = 9.5;

// --- НАСТРОЙКИ НА СФЕРАТА, ОТВОРА И КРАЯ ЗА ЗЪБНОТО КОЛЕЛО ---
ball_d        = 5.8;  // 5.8 мм (за новата 6.0 мм чашка) или 6.6 мм (за старата 7.0 мм чашка)
pin_hole_d    = 1.75; // УВЕЛИЧЕН отвор за щифта (беше 1.55 мм)
flat_z        = 2.25; // Разстояние от центъра до плоската основа (4.5 мм обща височина)
neck_free_len = 5.5;  // Кръгла шийка (без опорно ребро) от центъра на сферата - за завой ±20°

// Достъп до размерите от други файлове (use <...> внася само модули и функции, не и променливи)
function dogbone_param(key) =
    let (t = [
        ["half_len", sqrt(pow(dogbone_l, 2) + pow(diff_z_offset, 2)) / 2], // 27.415 мм
        ["ball_d", ball_d], ["pin_hole_d", pin_hole_d], ["flat_z", flat_z]
    ], i = search([key], t)[0])
    assert(is_num(i), str("dogbone_param: непознат ключ ", key))
    t[i][1];

// Напречно сечение на правия край (Ф4.5 мм + плоска основа 3.6 мм) - същото като тялото
// в single_dogbone_shaft_printable(); u = Y, w = Z (основата е към -Z). Ползва се за отвора
// на зъбното колело, което се набива на края.
module dogbone_body_profile_2d() {
    hull() {
        circle(d = 4.5);
        translate([-1.8, -flat_z]) square([3.6, 0.4]);
    }
}

module single_dogbone_shaft_printable() {
    full_len = sqrt(pow(dogbone_l, 2) + pow(diff_z_offset, 2)); // 54.83 мм
    half_len = full_len / 2;                                    // 27.42 мм (наполовина!)
    
    color("MediumSeaGreen")
    difference() {
        union() {
            // 1. Една сфера в левия край (X = 0)
            sphere(d = ball_d);
            
            // 2. Шийка Ф3.5 мм при сферата - БЕЗ ребро в първите neck_free_len мм (влизат в чашката
            //    при завиване; с ребро завоят е само ±15°, без него - ±20°). При печат тази част е
            //    0.5 мм над плочата - къс мост между сферата и ребрата.
            rotate([0, 90, 0]) cylinder(d = 3.5, h = neck_free_len + 0.01);

            //    + Опора до плоската база (Z = -flat_z) след neck_free_len
            hull() {
                translate([neck_free_len, 0, 0]) rotate([0, 90, 0]) cylinder(d = 3.5, h = half_len - neck_free_len);
                translate([neck_free_len, -1.2, -flat_z]) cube([half_len - neck_free_len, 2.4, 0.4]);
            }
            
            // 3. Усилено централно тяло Ф4.5 мм (започва с конус след шийката и върви до края за зъбното колело)
            hull() {
                translate([6.5, 0, 0]) rotate([0, 90, 0]) cylinder(d = 3.5, h = 0.1);
                translate([9.0, 0, 0]) rotate([0, 90, 0]) cylinder(d = 4.5, h = half_len - 9.0);
                translate([9.0, -1.8, -flat_z]) cube([half_len - 9.0, 3.6, 0.4]);
            }
        }
        
        // 4. Срязване отдолу за плътна първа контактна повърхност върху плочата на принтера
        translate([-10, -10, -flat_z - 10])
            cube([half_len + 20, 20, 10]);
            
        // 5. Симетрично срязване отгоре за баланс
        translate([-10, -10, flat_z])
            cube([half_len + 20, 20, 10]);
            
        // 6. По-голям вертикален отвор за стоманения щифт (Ф1.75 мм) само в сферата при X = 0
        cylinder(d = pin_hole_d, h = 12, center = true);
    }
}

// Визуализация в изправено положение за директен експорт към STL (без подпори!)
translate([0, 0, flat_z])
    single_dogbone_shaft_printable();